{
  "name": "@ticoag/lark-mcp",
  "version": "0.5.8",
  "description": "Feishu/Lark OpenAPI MCP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "ticoag",
  "license": "MIT",
  "bin": {
    "lark-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "README_ZH.md",
    "README_RECALL.md",
    "README_RECALL_ZH.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "ts-node src/index.ts",
    "dev:cli": "ts-node src/cli.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "node -e \"if (!process.env.CI) process.exit(1); console.log('Skipping prepare build in CI')\" || npm run build",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test": "jest",
    "test:ci": "jest tests/auth/store.test.ts tests/command-surface/command-surface.test.ts tests/command-surface/default-registry.test.ts tests/mcp-server/shared/init.test.ts tests/mcp-tool/mcp-tool.test.ts --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "feishu",
    "lark",
    "mcp",
    "open-api",
    "ai"
  ],
  "homepage": "https://github.com/ticoag/lark/tree/main/lark-openapi-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/ticoag/lark.git",
    "directory": "lark-openapi-mcp"
  },
  "bugs": {
    "url": "https://github.com/ticoag/lark/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.50.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.8.4",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "env-paths": "^2.2.1",
    "express": "^5.1.0",
    "keytar": "^7.9.0",
    "open": "^8.4.2",
    "proxy-agent": "^6.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.4.5",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
